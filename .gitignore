# Data and artifacts. `data/` is ignored wholesale rather than by extension:
# an earlier version listed *.txt, *.json and *.bin, and `data/tokens/*.npy`
# walked straight through the gap. Corpora and checkpoints do not belong in a
# repository people clone to learn from.
data/*
!data/download.py
checkpoints/
runs/
*.safetensors
*.npy
*.npz

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# macOS / editors
.DS_Store
.vscode/
.idea/

# xcode (chapter 08)
08_ship_ios/**/xcuserdata/
08_ship_ios/**/*.xcuserstate
08_ship_ios/**/DerivedData/
